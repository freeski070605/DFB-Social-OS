DFB_DATABASE_URL=sqlite:///./data/dfb.sqlite3
DFB_STORAGE_ROOT=./data/media
DFB_OLLAMA_URL=http://127.0.0.1:11434
DFB_COOKIE_SECURE=false
DFB_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://localhost:5173","http://127.0.0.1:5173"]
# For permanent HTTPS access, set DFB_COOKIE_SECURE=true and add
# "https://social.dfbsolutions.co" to DFB_ALLOWED_ORIGINS (keep local entries).
# Generate using scripts/setup.ps1. Retain this key with backups.
DFB_ENCRYPTION_KEY=
# Keep local_unavailable until a dedicated public R2 publishing bucket is configured.
DFB_PUBLIC_MEDIA_PROVIDER=local_unavailable
# R2 credentials stay on the backend. Use a bucket containing publishing objects only.
DFB_R2_ACCOUNT_ID=
DFB_R2_ACCESS_KEY_ID=
DFB_R2_SECRET_ACCESS_KEY=
DFB_R2_BUCKET=
DFB_R2_PUBLIC_BASE_URL=
# Legacy reserved S3 settings are not used by the R2 adapter.
DFB_S3_ENDPOINT=
DFB_S3_BUCKET=
DFB_S3_REGION=
DFB_S3_ACCESS_KEY=
DFB_S3_SECRET_KEY=
DFB_S3_PUBLIC_BASE_URL=
DFB_META_API_VERSION=v23.0
DFB_META_APP_ID=
DFB_META_APP_SECRET=
# Facebook Login for Business configuration ID (system-user access token).
DFB_META_CONFIG_ID=
# Exact HTTPS Facebook Login redirect URI, registered in the Meta app.
# Permanent same-origin value: https://social.dfbsolutions.co/api/meta/callback
DFB_META_REDIRECT_URI=
DFB_META_VERIFY_TOKEN=
# YouTube channel identity OAuth. Configure a Google Web application and exact redirect URI.
DFB_YOUTUBE_CLIENT_ID=
DFB_YOUTUBE_CLIENT_SECRET=
DFB_YOUTUBE_REDIRECT_URI=
# Permanent same-origin value: https://social.dfbsolutions.co/api/youtube/callback
DFB_SCHEDULER_ENABLED=true
