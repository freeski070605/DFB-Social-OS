DFB_DATABASE_URL=sqlite:///./data/dfb.sqlite3
DFB_STORAGE_ROOT=./data/media
DFB_OLLAMA_URL=http://127.0.0.1:11434
DFB_COOKIE_SECURE=false
DFB_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://localhost:5173","http://127.0.0.1:5173"]
# Generate using scripts/setup.ps1. Retain this key with backups.
DFB_ENCRYPTION_KEY=
# Public image publishing is disabled until a remote provider adapter is installed.
DFB_PUBLIC_MEDIA_PROVIDER=local_unavailable
# Reserved for an S3-compatible remote provider. These alone do not enable publishing.
DFB_S3_ENDPOINT=
DFB_S3_BUCKET=
DFB_S3_REGION=
DFB_S3_ACCESS_KEY=
DFB_S3_SECRET_KEY=
DFB_S3_PUBLIC_BASE_URL=
DFB_META_API_VERSION=v23.0
DFB_META_APP_ID=
DFB_META_APP_SECRET=
# Exact HTTPS Facebook Login redirect URI, registered in the Meta app.
DFB_META_REDIRECT_URI=
DFB_META_VERIFY_TOKEN=
DFB_SCHEDULER_ENABLED=true
